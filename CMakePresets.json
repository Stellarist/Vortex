{
    "version": 8,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/Build",
            "installDir": "${sourceDir}/Bin",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "26",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "X_VCPKG_APPLOCAL_DEPS_INSTALL": "ON"
            }
        },
        {
            "name": "clang-release",
            "displayName": "Clang Release",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "clang-debug",
            "displayName": "Clang Debug",
            "inherits": "clang-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "msvc-release",
            "displayName": "MSVC Release",
            "inherits": "base",
            "generator": "Visual Studio 18 2026",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "msvc-debug",
            "displayName": "MSVC Debug",
            "inherits": "msvc-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "clang-build-release",
            "displayName": "Build Clang Release",
            "configurePreset": "clang-release"
        },
        {
            "name": "clang-build-debug",
            "displayName": "Build Clang Debug",
            "configurePreset": "clang-debug"
        },
        {
            "name": "msvc-build-release",
            "displayName": "Build MSVC Release",
            "configurePreset": "msvc-release"
        },
        {
            "name": "msvc-build-debug",
            "displayName": "Build MSVC Debug",
            "configurePreset": "msvc-debug"
        }
    ]
}